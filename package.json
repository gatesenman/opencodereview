{
  "name": "open-code-review-desktop",
  "version": "0.2.13",
  "description": "Cross-platform desktop GUI for OpenCodeReview (wraps the ocr CLI)",
  "main": "./out/main/index.js",
  "author": "OpenCodeReview",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:all": "node --test test/*.test.mjs test/integration/*.test.mjs",
    "dist:win": "bash scripts/dist-win.sh"
  },
  "dependencies": {
    "highlight.js": "11.10.0",
    "marked": "14.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
